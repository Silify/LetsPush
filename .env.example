# Copy to .env and fill in. Never commit .env.

# Protects the stored Firebase keys and signs login sessions. At least 32 characters; keep it safe,
# because the stored Firebase keys cannot be read without it.   openssl rand -hex 32
LETSPUSH_SECRET=

# The first admin. Used only while there is no admin yet; remove the password afterwards.
LETSPUSH_ADMIN_EMAIL=
LETSPUSH_ADMIN_PASSWORD=

# Optional: build from a registry mirror or a Go proxy.
# NODE_IMAGE=node:24-alpine
# GO_IMAGE=golang:1.25-alpine
# RUN_IMAGE=alpine:3.22
# GOPROXY=https://proxy.golang.org,direct
